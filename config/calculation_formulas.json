    {
      "id": "tn_uv_hj636_2012",
      "indicator": "总氮",
      "aliases": ["总氮", "TN"],
      "method_name": "碱性过硫酸钾消解紫外分光光度法",
      "method_standard": "HJ 636-2012",
      "result_unit": "mg/L",
      "required_inputs": ["a220", "a275", "slope", "intercept", "sample_volume_ml"],
      "defaults": {"blank_mass_ug": 0, "dilution_factor": 1},
      "derived": [
        {"name": "corrected_absorbance", "expression": "a220 - 2 * a275"},
        {"name": "mass_ug", "expression": "(corrected_absorbance - intercept) / slope - blank_mass_ug"}
      ],
      "result_expression": "mass_ug / sample_volume_ml * dilution_factor",
      "tolerance": {"absolute": 0.05, "relative": 0.05},
      "source_files": [
        "D:\\个人资料\\比赛内容\\环境检测标准\\地表水\\总氮\\总氮测定标准.pdf",
        "D:\\个人资料\\比赛内容\\环境检测标准\\地表水\\总氮\\总氮计算方法.docx"
      ],
      "notes": "HJ 636-2012 中校正吸光度 A=A220-2A275；若校准曲线返回浓度而非质量，应将 slope/intercept 口径同步录入。"
    },
    {
      "id": "nh3n_nessler_hj535_2009",
      "indicator": "氨氮",
      "aliases": ["氨氮", "NH3-N", "NH₃-N", "铵氮"],
