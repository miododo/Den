    {
      "id": "do_probe_hj506_2009",
      "indicator": "溶解氧",
      "aliases": ["溶解氧", "DO"],
      "method_name": "电化学探头法温度校正",
      "method_standard": "HJ 506-2009",
      "result_unit": "mg/L",
      "required_inputs": ["apparent_do_mg_l", "solubility_measure_mg_l", "solubility_calibration_mg_l"],
      "defaults": {},
      "derived": [],
      "result_expression": "apparent_do_mg_l * solubility_measure_mg_l / solubility_calibration_mg_l",
      "tolerance": {"absolute": 0.3, "relative": 0.05},
      "source_files": [
        "D:\\个人资料\\比赛内容\\环境检测标准\\地表水\\溶解氧\\溶解氧计算.docx"
      ],
      "notes": "对应温度校正 ρ(O)=ρ'(O)×ρ(O)m/ρ(O)c。"
    },
    {
      "id": "do_pressure_hj506_2009",
      "indicator": "溶解氧",
      "aliases": ["溶解氧", "DO"],
      "method_name": "电化学探头法气压校正",
      "method_standard": "HJ 506-2009",
      "result_unit": "mg/L",
      "required_inputs": ["default_pressure_do_mg_l", "pressure_kpa", "water_vapor_pressure_kpa"],
      "defaults": {},
      "derived": [],
      "result_expression": "default_pressure_do_mg_l * (pressure_kpa - water_vapor_pressure_kpa) / (101.325 - water_vapor_pressure_kpa)",
      "tolerance": {"absolute": 0.3, "relative": 0.05},
      "source_files": [
        "D:\\个人资料\\比赛内容\\环境检测标准\\地表水\\溶解氧\\溶解氧计算.docx"
      ],
      "notes": "对应气压校正式，需提供测量气压和该温度饱和水蒸气压。"
    },
    {
      "id": "bod5_dilution_hj505_2009",
