      ],
      "notes": "适用于重铬酸盐法常规滴定计算；氯离子干扰、稀释倍数和空白扣除须与实验记录一致。"
    },
    {
      "id": "codmn_permanganate_gb11892_1989",
      "indicator": "高锰酸盐指数",
      "aliases": ["高锰酸盐指数", "CODMn"],
      "method_name": "酸性高锰酸钾法",
      "method_standard": "GB 11892-1989",
      "result_unit": "mg/L",
      "required_inputs": ["sample_titrant_ml", "blank_titrant_ml", "c_permanganate_mol_l", "sample_volume_ml"],
      "defaults": {"dilution_factor": 1},
      "derived": [
        {"name": "titrant_delta_ml", "expression": "sample_titrant_ml - blank_titrant_ml"}
      ],
      "result_expression": "titrant_delta_ml * c_permanganate_mol_l * 8000 / sample_volume_ml * dilution_factor",
      "tolerance": {"absolute": 0.5, "relative": 0.08},
      "source_files": [
        "D:\\个人资料\\比赛内容\\环境检测标准\\地表水\\高锰酸钾盐指数\\高锰酸盐指数测定方法.pdf",
        "D:\\个人资料\\比赛内容\\环境检测标准\\地表水\\高锰酸钾盐指数\\高锰酸盐指数计算方法(1).docx"
      ],
