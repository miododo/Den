      "method_standard": "HJ 535-2009",
      "result_unit": "mg/L",
      "required_inputs": ["absorbance", "blank_absorbance", "slope", "intercept", "sample_volume_ml"],
      "defaults": {"dilution_factor": 1},
      "derived": [
        {"name": "net_absorbance", "expression": "absorbance - blank_absorbance"},
        {"name": "mass_ug", "expression": "(net_absorbance - intercept) / slope"}
      ],
      "result_expression": "mass_ug / sample_volume_ml * dilution_factor",
      "tolerance": {"absolute": 0.02, "relative": 0.05},
      "source_files": [
        "D:\\个人资料\\比赛内容\\环境检测标准\\地表水\\氨氮\\氨氮的测定（纳氏试剂分光光度法）.pdf",
