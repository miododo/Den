    {
      "id": "cod_dichromate_hj828_2017",
      "indicator": "COD",
      "aliases": ["COD", "CODCr", "化学需氧量"],
      "method_name": "重铬酸盐法",
      "method_standard": "HJ 828-2017",
      "result_unit": "mg/L",
      "required_inputs": ["c_ferrous_ammonium_sulfate_mol_l", "blank_volume_ml", "sample_volume_titrant_ml", "sample_volume_ml"],
      "defaults": {"dilution_factor": 1},
      "derived": [
        {
          "name": "titrant_delta_ml",
          "expression": "blank_volume_ml - sample_volume_titrant_ml"
        }
      ],
      "result_expression": "c_ferrous_ammonium_sulfate_mol_l * titrant_delta_ml * 8000 / sample_volume_ml * dilution_factor",
      "tolerance": {"absolute": 5, "relative": 0.08},
      "source_files": [
        "D:\\个人资料\\比赛内容\\环境检测标准\\地表水\\化学需氧量\\化学需氧量测定方法.pdf",
